#!/usr/bin/env bash
# Blocks commits whose package.json / package-lock.json `npm ci` would reject,
# that leave install scripts unapproved, whose templates drop a data-testid
# the Playwright workflows select, or whose TypeScript fails lint or the
# test type check (what CI's backend-tests / frontend-tests run first). Enabled by `make install`
# (git config core.hooksPath .githooks). Checks the working tree of each
# package whose manifests are staged; skip once with `git commit --no-verify`.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
status=0

for pkg in backend frontend; do
  git diff --cached --quiet -- "$pkg/package.json" "$pkg/package-lock.json" && continue
  "$root/tools/check-lockfile.sh" "$root/$pkg" || status=1
  "$root/tools/check-install-scripts.sh" "$root/$pkg" || status=1
  if [ "$pkg" = frontend ]; then
    "$root/frontend/scripts/check-denied-deps.mjs" || status=1
  fi
done

# Templates must keep the selectors the Playwright workflows use.
if ! git diff --cached --quiet -- 'frontend/src/*.html'; then
  "$root/frontend/scripts/check-browser-selectors.mjs" || status=1
fi

# Staged TypeScript: lint those files, then type-check the package's tests,
# which import the application code (a few seconds each).
for pkg in backend frontend; do
  files=()
  while IFS= read -r f; do
    files+=("${f#"$pkg"/}")
  done < <(git diff --cached --name-only --diff-filter=ACMR -- "$pkg/*.ts" "$pkg/*.mjs")
  [ "${#files[@]}" -eq 0 ] && continue
  if [ ! -d "$root/$pkg/node_modules" ]; then
    echo "pre-commit: $pkg/node_modules is missing; run npm ci in $pkg" >&2
    status=1
    continue
  fi
  (cd "$root/$pkg" && npx --no-install eslint --no-warn-ignored --quiet "${files[@]}") || status=1
  (cd "$root/$pkg" && npm run -s test:typecheck) || {
    echo "pre-commit: $pkg test:typecheck failed; a stale node_modules also fails it (npm ci in $pkg)" >&2
    status=1
  }
done

exit $status
