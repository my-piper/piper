#!/usr/bin/env bash
# Blocks commits whose package.json / package-lock.json `npm ci` would reject,
# that leave install scripts unapproved, or whose templates drop a data-testid
# the Playwright workflows select. Enabled by `make install`
# (git config core.hooksPath .githooks). Checks the working tree of each
# package whose manifests are staged; skip once with `git commit --no-verify`.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
status=0

for pkg in backend frontend; do
  git diff --cached --quiet -- "$pkg/package.json" "$pkg/package-lock.json" && continue
  "$root/tools/check-lockfile.sh" "$root/$pkg" || status=1
  "$root/tools/check-install-scripts.sh" "$root/$pkg" || status=1
  if [ "$pkg" = frontend ]; then
    "$root/frontend/scripts/check-denied-deps.mjs" || status=1
  fi
done

# Templates must keep the selectors the Playwright workflows use.
if ! git diff --cached --quiet -- 'frontend/src/*.html'; then
  "$root/frontend/scripts/check-browser-selectors.mjs" || status=1
fi

exit $status
