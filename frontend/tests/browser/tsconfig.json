/* Playwright browser workflows: Node + Playwright types only, no Jasmine globals. */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "types": ["node"],
    "strict": true,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "../fixtures/plain.ts",
    "../fixtures/runtime-config.ts"
  ]
}
