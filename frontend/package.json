{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --allowed-hosts",
    "build": "ng build --localize",
    "sync-schemas": "cp ../backend/schemas/compiled.json ./src/schemas/compiled.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --progress=false",
    "test:agent": "ng test --watch=false --progress=false --reporters=agent",
    "test:watch": "ng test --watch=true",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck:templates": "scripts/check-templates.sh",
    "test:coverage": "ng test --watch=false --progress=false --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tests": "eslint tests vitest.config.ts",
    "test:browser": "ng build --configuration production,browser-test && playwright test -c tests/browser/playwright.config.ts",
    "test:browser:run": "playwright test -c tests/browser/playwright.config.ts",
    "test:browser:typecheck": "tsc -p tests/browser/tsconfig.json",
    "browser:serve": "ng build --configuration production,browser-test && esbuild tests/browser/support/serve.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=tests/browser/support/serve.bundle.mjs && node tests/browser/support/serve.bundle.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@apidevtools/json-schema-ref-parser": "^11.7.3",
    "@json-editor/json-editor": "^2.15.2",
    "@ng-web-apis/intersection-observer": "5.4.1",
    "@taiga-ui/addon-table": "5.33.0",
    "@taiga-ui/core": "5.33.0",
    "@taiga-ui/icons": "5.33.0",
    "@taiga-ui/kit": "5.33.0",
    "@taiga-ui/layout": "5.33.0",
    "ajv": "^8.17.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^2.30.0",
    "date-fns-timezone": "^0.1.4",
    "flat": "^6.0.1",
    "js-base64": "^3.7.7",
    "jsondiffpatch": "^0.7.7",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "marked": "^14.1.2",
    "monaco-editor": "^0.56.0",
    "nanoid": "^5.0.7",
    "ng-hcaptcha": "^2.8.0",
    "ngx-monaco-editor-v2": "^22.0.5",
    "ngx-socket-io": "^4.11.1",
    "qs": "^6.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "url-parse": "^1.5.10",
    "yaml": "^2.6.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "~22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/localize": "^22.2.6",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "1.63.0",
    "@types/eslint__js": "^8.42.3",
    "@types/lodash": "^4.14.195",
    "@types/qs": "^6.15.1",
    "@types/url-parse": "^1.4.11",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9.10.0",
    "prettier": "3.3.3",
    "socket.io": "4.7.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.4.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true,
    "core-js": false
  }
}
