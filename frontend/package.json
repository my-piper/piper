{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-live-reload --host 0.0.0.0 --disable-host-check",
    "build": "ng build --localize",
    "sync-schemas": "cp ../backend/schemas/compiled.json ./src/schemas/compiled.json",
    "watch": "ng build --watch --configuration development",
    "i18n": "npm run ng extract-i18n -- --output-path src/locale --out-file en.json --format json",
    "i18n:check": "scripts/check-i18n.sh",
    "test": "ng test --watch=false --progress=false",
    "test:watch": "ng test --watch=true",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck:templates": "scripts/check-templates.sh",
    "test:coverage": "ng test --watch=false --progress=false --code-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tests": "eslint tests karma.conf.cjs",
    "test:browser": "ng build --configuration production,browser-test && playwright test -c tests/browser/playwright.config.ts",
    "test:browser:run": "playwright test -c tests/browser/playwright.config.ts",
    "test:browser:typecheck": "tsc -p tests/browser/tsconfig.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@apidevtools/json-schema-ref-parser": "^11.7.3",
    "@json-editor/json-editor": "^2.15.2",
    "ajv": "^8.17.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookiejs": "^2.1.3",
    "date-fns": "^2.30.0",
    "date-fns-timezone": "^0.1.4",
    "flat": "^6.0.1",
    "js-base64": "^3.7.7",
    "jsondiffpatch": "^0.6.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "marked": "^14.1.2",
    "monaco-editor": "^0.44.0",
    "nanoid": "^5.0.7",
    "ng-hcaptcha": "^2.6.0",
    "ngx-monaco-editor-v2": "^17.0.1",
    "ngx-socket-io": "^4.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "url-parse": "^1.5.10",
    "yaml": "^2.6.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "~19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@angular/localize": "^19.2.25",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "1.63.0",
    "@types/eslint__js": "^8.42.3",
    "@types/jasmine": "5.1.4",
    "@types/lodash": "^4.14.195",
    "@types/url-parse": "^1.4.11",
    "eslint": "^9.10.0",
    "jasmine-core": "5.1.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "prettier": "3.3.3",
    "socket.io": "4.7.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.4.0"
  },
  "overrides": {
    "karma-jasmine": {
      "jasmine-core": "$jasmine-core"
    }
  }
}
