{
  "type": "object",
  "title": "Project",
  "properties": {
    "_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "createdAt": { "dateObject": true },
    "createdBy": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string"
        }
      },
      "required": ["_id"]
    },
    "title": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "group": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "pipeline": {
      "$ref": "local://pipeline.json"
    },
    "launchRequest": {
      "$ref": "local://launch-request.json"
    },
    "cursor": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
