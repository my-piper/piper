NODE_ENV=test
LOG_LEVEL=debug
LOG_PRETTY=yes

# Only local development
SERVER_PORT=8081
SOCKETS_PORT=8082
OAUTH_PORT=8083
METRICS_PORT=8084
REGISTRY_PORT=8085

REDIS_URL=redis://127.0.0.1:6379/
IO_REDIS_URL=redis://127.0.0.1:6379/
BULL_REDIS_HOST=127.0.0.1

MONGO_URL=mongodb://127.0.0.1:27017

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_NATIVE_URL=127.0.0.1:9000

KAFKA_BROKER=127.0.0.1:9094

S3_ENDPOINT_URL=http://127.0.0.1/storage
S3_ACCESS_KEY_ID=xyzXYZ
S3_SECRET_ACCESS_KEY=xyzXYZ
S3_BASE_URL=http://localhost/storage
S3_DEFAULT_BUCKET_NAME=xyzXYZ

# Package Registry: uploaded node package code, served only to Deno.
# The bucket must not be public. Deno reaches the registry from its container,
# so REGISTRY_URL is the host as Deno sees it; it sends REGISTRY_TOKEN through
# DENO_AUTH_TOKENS (see tools/compose/compose.yaml).
REGISTRY_BUCKET_NAME=piper-registry
REGISTRY_URL=http://host.docker.internal:8085
REGISTRY_TOKEN=local-registry-token

# OAuth
GOOGLE_CLIENT_ID=xyzXYZ
GOOGLE_CLIENT_SECRET=xyzXYZ

YANDEX_CLIENT_ID=xyzXYZ
YANDEX_CLIENT_SECRET=xyzXYZ

# Assistant
ACTIVATE_ASSISTANT=yes
LLM_API_KEY=xyzXYZ
LLM_MODEL=gpt-4.1
